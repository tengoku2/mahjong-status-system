{
  "name": "mahjong-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "mortal:prepare": "tsx scripts/prepare-mortal-preview.ts",
    "mortal:check": "tsx scripts/check-mortal-preview.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "node scripts/start-production.mjs",
    "register": "tsx src/register-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:smoke": "tsx scripts/smoke.ts",
    "tanki:watch": "tsx scripts/watch-vrchat-tanki-log.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:sqlite-to-postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "rules:seed": "tsx scripts/seed-rule-sets.ts",
    "admin:fix-result": "tsx scripts/admin-fix-match-result.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
