generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  guildId           String                @id @map("guild_id")
  users             User[]
  profiles          UserProfile[]
  matches           Match[]
  ruleSets          RuleSet[]
  events            Event[]
  adjustments       Adjustment[]
  seasonBonuses     SeasonBonus[]
  seasonLockSetting SeasonLockSetting?
  nanikiruSetting   NanikiruGuildSetting?
  nanikiruProblems  NanikiruProblem[]
  createdAt         DateTime              @default(now()) @map("created_at")

  @@map("guilds")
}

model User {
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([guildId, userId])
  @@map("users")
}

model UserProfile {
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  vrcName   String   @map("vrc_name")
  updatedAt DateTime @updatedAt @map("updated_at")
  guild     Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, userId])
  @@map("user_profiles")
}

model Match {
  matchId        String         @id @default(cuid()) @map("match_id")
  guildId        String         @map("guild_id")
  type           String
  gameType       GameType?      @map("game_type")
  eventId        String?        @map("event_id")
  ruleSetId      String?        @map("rule_set_id")
  tournamentName String?        @map("tournament_name")
  playedAt       DateTime       @default(now()) @map("played_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  aborted        Boolean        @default(false)
  abortReason    String?        @map("abort_reason")
  guild          Guild          @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  event          Event?         @relation(fields: [eventId], references: [eventId], onDelete: SetNull)
  ruleSet        RuleSet?       @relation(fields: [ruleSetId], references: [ruleSetId], onDelete: SetNull)
  results        Result[]
  externalMatch  ExternalMatch?
  hands          Hand[]

  @@index([guildId, type, playedAt])
  @@index([guildId, type, tournamentName, playedAt])
  @@index([guildId, gameType, playedAt])
  @@index([guildId, eventId, gameType, playedAt])
  @@index([guildId, ruleSetId, playedAt])
  @@map("matches")
}

model Result {
  resultId String @id @default(cuid()) @map("result_id")
  matchId  String @map("match_id")
  userId   String @map("user_id")
  seat     Int?
  rank     Int
  rawScore Int    @map("raw_score")
  point    Float
  match    Match  @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, rank])
  @@index([userId])
  @@map("results")
}

enum GameType {
  FOUR_PLAYER_HANCHAN  @map("4p_hanchan")
  THREE_PLAYER_HANCHAN @map("3p_hanchan")
  FOUR_PLAYER_TONPU    @map("4p_tonpu")
  THREE_PLAYER_TONPU   @map("3p_tonpu")
}

enum EventKind {
  NORMAL
  TOURNAMENT
  LEAGUE
  TEST
}

enum EventStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TieBreakType {
  SEAT_ORDER
  SPLIT_UMA
}

enum RoundExtension {
  NONE
  SOUTH
  WEST
}

model RuleSet {
  ruleSetId      String         @id @default(cuid()) @map("rule_set_id")
  guildId        String         @map("guild_id")
  name           String
  gameType       GameType       @map("game_type")
  startScore     Int            @map("start_score")
  returnScore    Int            @map("return_score")
  uma            Json
  allowBust      Boolean        @map("allow_bust")
  bustThreshold  Int?           @map("bust_threshold")
  allowAgariYame Boolean        @map("allow_agari_yame")
  roundExtension RoundExtension @map("round_extension")
  tieBreakType   TieBreakType   @map("tie_break_type")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  guild          Guild          @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  events         Event[]
  matches        Match[]

  @@unique([guildId, name])
  @@index([guildId, gameType, isActive])
  @@map("rule_sets")
}

model Event {
  eventId     String       @id @default(cuid()) @map("event_id")
  guildId     String       @map("guild_id")
  ruleSetId   String       @map("rule_set_id")
  name        String
  kind        EventKind
  status      EventStatus  @default(ACTIVE)
  startsAt    DateTime?    @map("starts_at")
  endsAt      DateTime?    @map("ends_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  guild       Guild        @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  ruleSet     RuleSet      @relation(fields: [ruleSetId], references: [ruleSetId], onDelete: Restrict)
  matches     Match[]
  adjustments Adjustment[]

  @@unique([guildId, name])
  @@index([guildId, kind, status])
  @@index([guildId, ruleSetId])
  @@map("events")
}

model Adjustment {
  adjustmentId String    @id @default(cuid()) @map("adjustment_id")
  guildId      String    @map("guild_id")
  eventId      String    @map("event_id")
  userId       String    @map("user_id")
  gameType     GameType  @map("game_type")
  amount       Float
  reason       String
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  guild        Guild     @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  event        Event     @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@index([guildId, eventId, gameType])
  @@index([guildId, userId, gameType])
  @@index([deletedAt])
  @@map("adjustments")
}

model ExternalMatch {
  externalSource  String   @map("external_source")
  externalMatchId String   @map("external_match_id")
  guildId         String   @map("guild_id")
  matchId         String   @unique @map("match_id")
  createdAt       DateTime @default(now()) @map("created_at")
  match           Match    @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@id([externalSource, externalMatchId])
  @@index([guildId])
  @@map("external_matches")
}

enum HandEndType {
  AGARI
  RYUKYOKU
  ABORTIVE
  FORCED_END
}

model Hand {
  handId       String           @id @default(cuid()) @map("hand_id")
  matchId      String           @map("match_id")
  handIndex    Int              @map("hand_index")
  roundWind    String           @map("round_wind")
  roundNumber  Int              @map("round_number")
  honba        Int              @default(0)
  kyotaku      Int              @default(0)
  dealerUserId String?          @map("dealer_user_id")
  endType      HandEndType      @map("end_type")
  abortReason  String?          @map("abort_reason")
  createdAt    DateTime         @default(now()) @map("created_at")
  match        Match            @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  playerStats  HandPlayerStat[]

  @@unique([matchId, handIndex])
  @@index([matchId, roundWind, roundNumber])
  @@index([dealerUserId])
  @@map("hands")
}

model HandPlayerStat {
  handPlayerStatId   String   @id @default(cuid()) @map("hand_player_stat_id")
  handId             String   @map("hand_id")
  userId             String   @map("user_id")
  seat               Int?     @map("seat")
  startScore         Int?     @map("start_score")
  endScore           Int?     @map("end_score")
  isTenpaiAtRyukyoku Boolean? @map("is_tenpai_at_ryukyoku")
  declaredRiichi     Boolean  @default(false) @map("declared_riichi")
  calledOpenMeld     Boolean  @default(false) @map("called_open_meld")
  won                Boolean  @default(false)
  wonByTsumo         Boolean  @default(false) @map("won_by_tsumo")
  dealtIn            Boolean  @default(false) @map("dealt_in")
  winScore           Int?     @map("win_score")
  dealInScore        Int?     @map("deal_in_score")
  winOrder           Int?     @map("win_order")
  isDama             Boolean? @map("is_dama")
  ippatsuWin         Boolean? @map("ippatsu_win")
  uraDoraCount       Int?     @map("ura_dora_count")
  hand               Hand     @relation(fields: [handId], references: [handId], onDelete: Cascade)

  @@unique([handId, userId])
  @@index([userId])
  @@index([won, dealtIn])
  @@map("hand_player_stats")
}

model NanikiruGuildSetting {
  guildId           String   @id @map("guild_id")
  questionChannelId String?  @map("question_channel_id")
  resultChannelId   String?  @map("result_channel_id")
  updatedAt         DateTime @updatedAt @map("updated_at")
  guild             Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("nanikiru_guild_settings")
}

model SeasonLockSetting {
  guildId            String   @id @map("guild_id")
  adminChannelId     String?  @map("admin_channel_id")
  unlockedSeasonCode String?  @map("unlocked_season_code")
  unlockedSeasonYear Int?     @map("unlocked_season_year")
  updatedAt          DateTime @updatedAt @map("updated_at")
  guild              Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("season_lock_settings")
}

model SeasonBonus {
  seasonBonusId String   @id @default(cuid()) @map("season_bonus_id")
  guildId       String   @map("guild_id")
  userId        String   @map("user_id")
  type          String
  seasonCode    String   @map("season_code")
  seasonYear    Int      @map("season_year")
  target        String
  point         Float
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  guild         Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, type, seasonCode, seasonYear])
  @@index([guildId, userId, seasonCode, seasonYear])
  @@map("season_bonuses")
}

model NanikiruProblem {
  questionId        String           @id @map("question_id")
  guildId           String           @map("guild_id")
  hand              String
  redDoraTiles      String           @default("") @map("red_dora_tiles")
  bestShanten       Int              @map("best_shanten")
  bestDiscardCount  Int              @default(1) @map("best_discard_count")
  shantenFilter     String           @map("shanten_filter")
  honorTileMode     String           @map("honor_tile_mode")
  doraTile          Int?             @map("dora_tile")
  doraTiles         String?          @map("dora_tiles")
  note              String?
  turnNumber        Int?             @map("turn_number")
  seatWind          String?          @map("seat_wind")
  roundWind         String?          @map("round_wind")
  roundNumber       Int?             @map("round_number")
  questionChannelId String           @map("question_channel_id")
  resultChannelId   String?          @map("result_channel_id")
  messageId         String           @map("message_id")
  closesAt          DateTime         @map("closes_at")
  closedAt          DateTime?        @map("closed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  guild             Guild            @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  answers           NanikiruAnswer[]

  @@index([guildId, closesAt])
  @@index([closedAt, closesAt])
  @@map("nanikiru_problems")
}

model NanikiruAnswer {
  questionId String          @map("question_id")
  userId     String          @map("user_id")
  tile       Int
  updatedAt  DateTime        @updatedAt @map("updated_at")
  question   NanikiruProblem @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@id([questionId, userId])
  @@map("nanikiru_answers")
}
